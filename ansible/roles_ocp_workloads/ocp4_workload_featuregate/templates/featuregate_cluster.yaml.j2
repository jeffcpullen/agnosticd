---

apiVersion: config.openshift.io/v1
kind: FeatureGate
metadata:
  name: cluster
spec:
{% if ocp4_workload_featuregate_enabled or ocp4_workload_featuregate_disabled%}
  featureSet: CustomNoUpgrade
  customNoUpgrade:
{% if ocp4_workload_featuregate_enabled %}
    enabled: {{ ocp4_workload_featuregate_enabled }}
{% endif %}
{% if ocp4_workload_featuregate_disabled %}
    enabled: {{ ocp4_workload_featuregate_disabled }}
{% endif %}
{% endif %}
